        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(qc_request_duration_seconds_bucket{environment=~\"$environment\", release_id=~\"$release\"}[1m])))",
          "refId": "A",
