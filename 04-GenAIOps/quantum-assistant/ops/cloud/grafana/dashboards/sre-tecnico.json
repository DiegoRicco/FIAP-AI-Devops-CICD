{
  "uid": "quantum-demo52",
  "title": "Visão técnica · SRE",
  "description": "Para Diego (AI SRE): golden signals do assistente na AWS (ECS live/candidate), latência por etapa, dependência de pedidos, qualidade dos probes e alertas.",
  "tags": [
    "quantum-assistente",
    "demo-5.2",
    "aws"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "liveNow": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "quantum-assistente"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Outras visões",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparando",
        "enable": true,
        "iconColor": "#F04E5E",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"}) unless max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"} offset 10s)",
        "step": "10s",
        "titleFormat": "Alerta acendeu: {{alertname}}",
        "textFormat": "severidade {{severity}}",
        "useValueForTime": false,
        "hide": false
      },
      {
        "name": "Corpus trocado (reload)",
        "enable": true,
        "iconColor": "#ED145B",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service_name=\"quantum-assistant\"} |= \"runtime.reload\" | json",
        "instant": false,
        "titleFormat": "Corpus trocado",
        "textFormat": "corpus {{corpus_version}}",
        "tagKeys": "",
        "hide": false
      },
      {
        "name": "Falha injetada na API de pedidos",
        "enable": true,
        "iconColor": "#E9A23B",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service_name=\"quantum-orders-api\"} |~ \"orders.faults_(updated|reset)\" | json",
        "instant": false,
        "titleFormat": "{{event}}",
        "textFormat": "erro {{error_rate}} latencia {{latency_ms}} ms",
        "tagKeys": "",
        "hide": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"qc_requests_total|qc_probe_total\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values({__name__=~\"qc_requests_total|qc_probe_total\"}, environment)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "live",
          "value": "live"
        }
      },
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(qc_probe_total{environment=~\"$environment\"}, release_id)",
          "refId": "release"
        },
        "definition": "label_values(qc_probe_total{environment=~\"$environment\"}, release_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "scenario_id",
        "label": "Cenário dos probes",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(qc_quality_status, scenario_id)",
          "refId": "scenario_id"
        },
        "definition": "label_values(qc_quality_status, scenario_id)",
        "includeAll": true,
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "live_watch",
          "value": "live_watch"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tráfego",
      "description": "Requisições por segundo no assistente do ambiente escolhido (último minuto). Golden signal: taxa.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(qc_requests_total{environment=~\"$environment\", release_id=~\"$release\"}[1m]))",
          "refId": "A",
          "legendFormat": "req/s",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0 req/s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F1EFEC",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F1EFEC"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erros 5xx",
      "description": "Fração das requisições do último minuto que terminaram em erro do servidor (5xx). Golden signal: erros.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(qc_requests_total{environment=~\"$environment\", release_id=~\"$release\", status_class=~\"5..\", route!~\"/ready|/health\"}[1m])) or vector(0)) / sum(rate(qc_requests_total{environment=~\"$environment\", release_id=~\"$release\"}[1m]))",
          "refId": "A",
          "legendFormat": "5xx",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostras",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DBE8B",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.01
              },
              {
                "color": "#F04E5E",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latência p95",
      "description": "95% das requisições do último minuto terminaram abaixo deste tempo. Golden signal: latência.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
