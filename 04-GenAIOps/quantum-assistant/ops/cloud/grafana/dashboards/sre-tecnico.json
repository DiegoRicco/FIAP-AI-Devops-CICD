    {
      "id": 9,
      "type": "timeseries",
      "title": "Qualidade da recuperação, do grafo e da citação (probes, janela 2m)",
      "description": "Hit@k: o documento certo veio entre os k recuperados. MRR: quão no topo. Citação: citou fonte quando devia. Fonte vigente: a fonte citada vale hoje. Grafo correto: o caminho chegou à versão esperada. Hit@k pode ficar em 100% enquanto fonte vigente e grafo caem: recuperar o documento certo não garante escolher a versão certa.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(qc:retrieval_hit_at_k:2m{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}) and on() (sum(qc_quality_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}) >= on() max(qc_quality_min_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}))",
          "refId": "A",
          "legendFormat": "Hit@k",
          "range": true,
