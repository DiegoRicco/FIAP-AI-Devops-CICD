          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(qc:probe_pass_rate:2m{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}) and on() (sum(qc_quality_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}) >= on() max(qc_quality_min_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}))",
          "refId": "A",
          "legendFormat": "pass rate",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostra suficiente",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F04E5E",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.9
              },
              {
                "color": "#3DBE8B",
                "value": 0.99
              }
