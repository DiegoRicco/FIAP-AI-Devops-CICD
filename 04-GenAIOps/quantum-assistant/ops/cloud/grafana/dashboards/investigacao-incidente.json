      "title": "Trace da requisição escolhida: clique num trace_id nos logs acima (ou cole no campo trace_id) e abra esta faixa",
      "panels": [
        {
          "id": 50,
          "type": "traces",
          "title": "Trace da requisição escolhida",
          "description": "Cada etapa da requisição na AWS (http.request, auth.tenant, intent.route, entity.link, graph.traverse ou vector.embed/query, policy.version.filter, compose.deterministic, orders.lookup) com o tempo e os atributos de versão de cada uma.",
          "gridPos": {
            "x": 0,
            "y": 31,
            "w": 24,
            "h": 14
          },
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
