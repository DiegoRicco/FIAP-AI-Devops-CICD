    {
      "id": 4,
      "type": "logs",
      "title": "Logs dos probes e do monitor de qualidade",
      "description": "Linhas JSON do qc-probe (um probe por linha, com trace_id, caso, motivo e versões) e do monitor de qualidade (mudanças de estado), guardadas no Loki da EC2 de observabilidade. Clique numa linha e use 'Ver este trace (Jaeger) no painel'.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"qc-probe|qc-quality-monitor\"} |= \"$busca\" | json | __error__=\"\" | drop severity, detected_level | label_format qc_level=`{{ .level }}` | label_format level=`{{ if eq .result \"fail\" }}error{{ else if eq .qc_level \"critical\" }}error{{ else if eq .qc_level \"warning\" }}warning{{ else }}info{{ end }}` | release_id=~\"$release|^$\" | environment=~\"$environment|^$\" | scenario_id=~\"$scenario_id|^$\" | line_format `{{ if .event }}{{ .event }}{{ else }}probe {{ .result }}{{ end }}{{ with .qc_level }}  nivel={{ . }}{{ end }}{{ with .case_id }}  caso={{ . }}{{ end }}{{ with .slice }}  slice={{ . }}{{ end }}{{ with .reason }}  motivo={{ . }}{{ end }}{{ with .http_status }}  http={{ . }}{{ end }}{{ with .latency_ms }}  {{ . }} ms{{ end }}{{ with .n }}  n={{ . }}{{ end }}{{ with .window }}  janela={{ . }}{{ end }}{{ with .release_id }}  release={{ . }}{{ end }}{{ with .graph_version }}  grafo={{ . }}{{ end }}{{ with .scenario_id }}  cenario={{ . }}{{ end }}{{ with .trace_id }}  trace_id={{ . }}{{ end }}`",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 49,
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
