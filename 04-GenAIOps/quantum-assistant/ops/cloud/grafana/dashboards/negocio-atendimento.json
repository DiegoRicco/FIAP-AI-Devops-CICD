{
  "uid": "qc-negocio",
  "title": "Visão do negócio · Atendimento",
  "description": "Para Helena e a liderança de CX: o cliente recebeu informação correta? Assistente na AWS (ECS), medido por probes rotulados que rodam na própria AWS contra o ALB.",
  "tags": [
    "quantum-assistente",
    "demo-5.2",
    "aws"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "liveNow": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "quantum-assistente"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Outras visões",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparando",
        "enable": false,
        "iconColor": "#F04E5E",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"}) unless max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"} offset 10s)",
        "step": "10s",
        "titleFormat": "Alerta acendeu: {{alertname}}",
        "textFormat": "severidade {{severity}}",
        "useValueForTime": false,
        "hide": true
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"qc_requests_total|qc_probe_total\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values({__name__=~\"qc_requests_total|qc_probe_total\"}, environment)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "live",
          "value": "live"
        }
      },
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(qc_probe_total{environment=~\"$environment\"}, release_id)",
          "refId": "release"
        },
        "definition": "label_values(qc_probe_total{environment=~\"$environment\"}, release_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "scenario_id",
        "label": "Cenário dos probes",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(qc_quality_status, scenario_id)",
          "refId": "scenario_id"
        },
        "definition": "label_values(qc_quality_status, scenario_id)",
        "includeAll": true,
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "live_watch",
          "value": "live_watch"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Confiança do assistente agora",
      "description": "Semáforo do monitor de qualidade (contêiner qc-probe na AWS), janela deslizante real com n mínimo. Verde: n suficiente, 90% ou mais corretos e nenhuma regra dura violada. Âmbar: menos de 90% corretos. Vermelho: ao menos um caso crítico (fonte que não vale hoje, outro tenant, pedido sem autorização ou caminho de grafo errado), não importa a média. Cinza: amostra insuficiente na janela, que NÃO é verde.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(qc_quality_status{scenario_id=~\"$scenario_id\", environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "semaforo",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem medição",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Amostra insuficiente",
                  "color": "#8E8B87",
                  "index": 0
                },
                "0": {
                  "text": "Confiável",
                  "color": "#3DBE8B",
                  "index": 1
                },
                "1": {
                  "text": "Atenção",
                  "color": "#E9A23B",
                  "index": 2
                },
                "2": {
                  "text": "Não confiável",
                  "color": "#F04E5E",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E8B87",
                "value": null
              },
              {
                "color": "#3DBE8B",
                "value": 0
              },
              {
                "color": "#E9A23B",
                "value": 1
              },
              {
                "color": "#F04E5E",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Perguntas atendidas",
      "description": "Quantas perguntas o assistente do ambiente escolhido respondeu no período (inclui os probes; health check do ALB não conta). Para o negócio: volume de atendimento sem atendente.",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(qc_requests_total{environment=~\"$environment\", release_id=~\"$release\", route!~\".*(health|ready|meta|static|favicon|metrics).*\"}[$__range]))",
          "refId": "A",
          "legendFormat": "perguntas",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F1EFEC",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F1EFEC"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Com a política vigente",
      "description": "Das respostas verificadas pelos probes nos últimos 5 minutos, quantas usaram a versão de política que vale hoje. Fica vermelho abaixo de 100%: uma única política vencida já é crítica. Sem o n mínimo na janela o painel diz 'Sem amostra suficiente' em vez de mostrar 100%.",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 5,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(qc_probe_source_current_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}[5m])) / sum(increase(qc_probe_source_checked_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}[5m]))) and on() (sum(qc_quality_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}) >= on() max(qc_quality_min_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}))",
          "refId": "A",
          "legendFormat": "vigente",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostra suficiente",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F04E5E",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.95
              },
              {
                "color": "#3DBE8B",
                "value": 0.9999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Caminho do grafo conferido",
      "description": "Das respostas dos probes que passaram pelo grafo (produto → categoria → campanha → política → versão) nos últimos 5 minutos, quantas chegaram à versão de política que o gabarito espera.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(qc_probe_graph_path_correct_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}[5m])) / sum(increase(qc_probe_graph_path_checked_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\"}[5m]))) and on() (sum(qc_quality_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}) >= on() max(qc_quality_min_samples{scenario_id=~\"$scenario_id\", environment=~\"$environment\"}))",
          "refId": "A",
          "legendFormat": "grafo",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostra suficiente",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F04E5E",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.95
              },
              {
                "color": "#3DBE8B",
                "value": 0.9999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pedidos sem status",
      "description": "Dos probes de pedido dos últimos 5 minutos, quantos ficaram sem status porque a API de pedidos não respondeu (o assistente recusou com honestidade). Sinal técnico, separado da qualidade documental.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(qc_probe_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\", result=\"fallback\"}[5m])) or vector(0)) / sum(increase(qc_probe_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\", slice=~\"pedidos|orders\"}[5m]))",
          "refId": "A",
          "legendFormat": "falhas",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostras",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DBE8B",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.05
              },
              {
                "color": "#F04E5E",
                "value": 0.2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Por que o semáforo está assim",
      "description": "Os probes que erraram nos últimos 2 minutos, agrupados pelo motivo. Tabela vazia com semáforo verde é o esperado.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 9,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (reason, release_id) (increase(qc_probe_total{scenario_id=~\"$scenario_id\", environment=~\"$environment\", release_id=~\"$release\", result=\"fail\"}[2m])) > 0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "Motivo",
              "release_id": "Release",
              "Value": "Probes que erraram"
            },
            "indexByName": {
              "reason": 0,
              "release_id": 1,
              "Value": 2
            }
          }
        }
      ],
