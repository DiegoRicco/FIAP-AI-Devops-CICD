          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(requests_total{job=\"quantum-assistant\", release_id=~\"$release\", status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(requests_total{job=\"quantum-assistant\", release_id=~\"$release\"}[1m]))",
          "refId": "A",
          "legendFormat": "5xx",
          "range": true,
          "instant": false
