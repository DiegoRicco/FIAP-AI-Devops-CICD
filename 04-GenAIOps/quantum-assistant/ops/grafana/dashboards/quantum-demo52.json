{
  "uid": "quantum-demo52",
  "title": "Quantum Commerce - Demo 5.2 - Tecnico x Qualidade",
  "description": "Ambiente de demonstracao local (runtime Python no Codespaces/Mac). Nao e a Lambda publicada.",
  "tags": [
    "quantum",
    "demo-5.2",
    "local-demo"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "release",
        "label": "release_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(quality_probes_total, release_id)",
          "refId": "release"
        },
        "definition": "label_values(quality_probes_total, release_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "corpus",
        "label": "corpus_version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(quality_probes_total{release_id=~\"$release\"}, corpus_version)",
          "refId": "corpus"
        },
        "definition": "label_values(quality_probes_total{release_id=~\"$release\"}, corpus_version)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
