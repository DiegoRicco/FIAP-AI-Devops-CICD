{
  "uid": "quantum-demo52",
  "title": "Visão técnica · SRE",
  "description": "Golden signals, qualidade dos probes e alertas do assistente. Ambiente local de demonstração (não é a Lambda publicada).",
  "tags": [
    "quantum-assistente",
    "demo-5.2",
    "local-demo"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "liveNow": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "quantum-assistente"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Outras visões",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparando",
        "enable": true,
        "iconColor": "#F04E5E",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"}) unless max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"} offset 10s)",
        "step": "10s",
        "titleFormat": "Alerta acendeu: {{alertname}}",
        "textFormat": "severidade {{severity}}",
        "useValueForTime": false,
        "hide": false
      },
      {
        "name": "Corpus trocado (reload)",
        "enable": true,
        "iconColor": "#ED145B",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service_name=\"quantum-assistant\"} |= \"runtime.reload\" | json",
        "instant": false,
        "titleFormat": "Corpus trocado",
        "textFormat": "corpus {{corpus_version}}",
        "tagKeys": "",
        "hide": false
      },
      {
        "name": "Falha injetada na API de pedidos",
        "enable": true,
        "iconColor": "#E9A23B",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service_name=\"quantum-orders-api\"} |~ \"orders.faults_(updated|reset)\" | json",
        "instant": false,
        "titleFormat": "{{event}}",
        "textFormat": "erro {{error_rate}} latencia {{latency_ms}} ms",
        "tagKeys": "",
        "hide": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(requests_total{job=\"quantum-assistant\"}, release_id)",
          "refId": "r"
        },
        "definition": "label_values(requests_total{job=\"quantum-assistant\"}, release_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "corpus",
        "label": "Versão do corpus",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(quality_probes_total, corpus_version)",
          "refId": "c"
        },
        "definition": "label_values(quality_probes_total, corpus_version)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tráfego",
      "description": "Requisições por segundo no assistente (último minuto). Golden signal: taxa.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(requests_total{job=\"quantum-assistant\", release_id=~\"$release\"}[1m]))",
          "refId": "A",
          "legendFormat": "req/s",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0 req/s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F1EFEC",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F1EFEC"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erros 5xx",
      "description": "Fração das requisições do último minuto que terminaram em erro do servidor. Golden signal: erros.",
