    {
      "id": 6,
      "type": "timeseries",
      "title": "Volume de logs por serviço",
      "description": "Linhas de log por minuto no Loki. Se um serviço some daqui, ele parou de escrever log (ou o Collector parou de ler).",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\"quantum-.+\"}[1m]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
