    {
      "id": 9,
      "type": "bargauge",
      "title": "Acerto dos probes por assunto",
      "description": "Os 6 assuntos com menor acerto: em cada um, a parte dos probes rotulados que acertou nos últimos 5 minutos. Ajuda a ver QUAL assunto está sofrendo, por exemplo só Políticas.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bottomk(6, sum by (slice) (increase(quality_probes_total{outcome=\"pass\"}[5m])) / sum by (slice) (increase(quality_probes_total{outcome=~\"pass|fail\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{slice}}",
          "range": false,
          "instant": true
