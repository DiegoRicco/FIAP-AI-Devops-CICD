    {
      "id": 3,
      "type": "stat",
      "title": "Com a política vigente",
      "description": "Das respostas verificadas pelos probes nos últimos 5 minutos, quantas citaram a versão de política que vale hoje. Fica vermelho abaixo de 100%: uma única política obsoleta já é crítica (diferente do limite de 90% do semáforo, que vale para acertos em geral). Para o negócio: cliente recebendo um prazo que a empresa não pratica mais.",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 5,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(quality_source_current_total[5m])) / sum(increase(quality_source_checked_total[5m]))",
          "refId": "A",
          "legendFormat": "vigente",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem amostras",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F04E5E",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.95
              },
              {
                "color": "#3DBE8B",
                "value": 0.9999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
