    {
      "id": 6,
      "type": "table",
      "title": "Por que o semáforo está assim",
      "description": "Os probes que erraram nos últimos 2 minutos, agrupados pelo motivo. Tabela vazia com semáforo verde é o esperado.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 9,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (reason, corpus_version) (increase(quality_probes_total{outcome=\"fail\"}[2m])) > 0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
