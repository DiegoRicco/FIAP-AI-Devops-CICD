            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(answers_total{job=\"quantum-assistant\"}[$__range]))",
          "refId": "A",
          "legendFormat": "perguntas",
          "range": false,
          "instant": true
