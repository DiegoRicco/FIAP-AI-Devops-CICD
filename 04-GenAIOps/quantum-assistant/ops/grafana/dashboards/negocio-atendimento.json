    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP verde não significa resposta certa",
      "description": "Linha verde: parte das requisições que o servidor respondeu sem erro técnico. Linha ciano: parte das respostas que estavam certas segundo os probes rotulados. No incidente de política obsoleta a linha verde continua em 100% enquanto a ciano cai abaixo da linha tracejada de 90%: monitorar só o HTTP esconderia o problema.",
      "gridPos": {
        "x": 9,
        "y": 7,
        "w": 15,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(rate(requests_total{job=\"quantum-assistant\", status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(requests_total{job=\"quantum-assistant\"}[1m])))",
          "refId": "A",
          "legendFormat": "Servidor respondeu sem erro (HTTP)",
          "range": true,
          "instant": false,
          "interval": "10s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(qc:synthetic_quality_pass_rate:2m)",
          "refId": "B",
          "legendFormat": "Resposta certa (probes rotulados)",
          "range": true,
          "instant": false,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 30000,
            "lineInterpolation": "smooth",
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E9A23B",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 0.9
              }
            ]
          },
          "min": 0.5,
          "max": 1.02,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Servidor respondeu sem erro (HTTP)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3DBE8B"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Resposta certa (probes rotulados)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5BC8D9"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
