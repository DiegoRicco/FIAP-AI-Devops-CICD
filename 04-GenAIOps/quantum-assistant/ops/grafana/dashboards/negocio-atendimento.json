    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "quantum-assistente"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Outras visões",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparando",
        "enable": false,
        "iconColor": "#F04E5E",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"}) unless max by (alertname, severity) (ALERTS{alertstate=\"firing\", severity=~\"warning|critical\"} offset 10s)",
        "step": "10s",
        "titleFormat": "Alerta acendeu: {{alertname}}",
        "textFormat": "severidade {{severity}}",
        "useValueForTime": false,
        "hide": true
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Confiança do assistente agora",
      "description": "Semáforo calculado a partir dos probes rotulados (perguntas com resposta conhecida) dos últimos 2 minutos. Verde: 90% ou mais corretos e nenhuma fonte obsoleta. Âmbar: menos de 90% corretos. Vermelho: o assistente citou política obsoleta ou documento proibido. Cinza: ninguém mediu nos últimos 2 minutos.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(ALERTS{alertstate=\"firing\", signal=\"quality\", severity=\"critical\"}) * 0 + 2) or (count(ALERTS{alertstate=\"firing\", alertname=\"QualityProbeDegraded\"}) * 0 + 1) or ((min(qc:synthetic_quality_pass_rate:2m) < 0.90) * 0 + 1) or ((min(qc:synthetic_quality_pass_rate:2m) >= 0.90) * 0)",
          "refId": "A",
          "legendFormat": "semaforo",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem medição",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Confiável",
                  "color": "#3DBE8B",
                  "index": 0
                },
                "1": {
                  "text": "Atenção",
                  "color": "#E9A23B",
                  "index": 1
                },
                "2": {
                  "text": "Não confiável",
                  "color": "#F04E5E",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DBE8B",
                "value": null
              },
              {
                "color": "#E9A23B",
                "value": 1
              },
              {
                "color": "#F04E5E",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto",
        "text": {
          "valueSize": 44
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Perguntas atendidas",
      "description": "Quantas perguntas o assistente respondeu no período escolhido no canto superior direito (inclui os probes). Para o negócio: volume de atendimento que não precisou de um atendente.",
      "gridPos": {
